# Токен бота — получить у @BotFather в Telegram
BOT_TOKEN=123456:your-telegram-bot-token

# Сайт расписания
RUZ_BASE_URL=https://ruz.guz.ru

# Название группы ровно так, как оно ищется на сайте
GROUP_NAME=Б.МН.25.Б3

# До какой даты тянуть расписание (конец осеннего семестра + сессия)
SEMESTER_END=2027-01-31

# Как часто проверять сайт на изменения, в минутах
CHECK_INTERVAL_MINUTES=20

# Часовой пояс
TIMEZONE=Europe/Moscow

# Файл, где бот хранит подписчиков и последний снимок расписания
STATE_FILE=state.json
